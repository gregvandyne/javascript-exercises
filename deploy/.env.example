# deploy/.env: settings for docker-compose.yml. Copy to .env, fill in, then: chmod 600 .env
# Never commit .env (it is git-ignored). Every variable is described in README.md (Configuration).

# --- The site -----------------------------------------------------------------------------------------------
# The domain Caddy serves and gets a certificate for. Its DNS A record must point at this server.
# Moving a domain that still points at Render: use a temporary name here (new.example.com) until moving day.
SITE_DOMAIN=play.example.com
# Let's Encrypt contacts you here about certificate problems (required).
ACME_EMAIL=you@example.com
# The address people use (the final one, also while SITE_DOMAIN is a temporary name).
PUBLIC_URL=https://play.example.com
# Where the block disk is mounted on this server (the SQLite file, cover pictures, photos, uploads).
DATA_DIR=/srv/oomba/data

# --- Secrets ------------------------------------------------------------------------------------------------
# Signs sign-in cookies. Moving from another host: paste the old one (scripts/export-session-secret.js) so nobody is
# signed out. New site: openssl rand -hex 32
SESSION_SECRET=
# Refuse to start without SESSION_SECRET (instead of quietly using one stored in the database).
REQUIRE_SESSION_SECRET=1
ADMIN_USERNAME=admin
# The admin password is reset to this on every start.
ADMIN_PASSWORD=
# The real AI Builder. Empty = the built-in mock Builder.
ANTHROPIC_API_KEY=

# Shared secret between the app and the screenshot worker ("shots" in docker-compose.yml), which takes the cover
# pictures with headless Chromium in its own container. Required: openssl rand -hex 32
SHOTS_TOKEN=

# --- AI limits ----------------------------------------------------------------------------------------------
BUILDER_DAILY_TURNS=60
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=50

# --- Backups off the server (Litestream), optional but strongly recommended -----------------------------------
# AWS S3: s3://BUCKET/oomba        Azure Blob: abs://STORAGEACCOUNT@CONTAINER/oomba
# Other S3-compatible stores: s3://BUCKET/oomba?endpoint=https://s3.example.net&forcePathStyle=true
# Turn on bucket versioning (S3) / soft delete + versioning (Azure) first: see the guide, section 2.
LITESTREAM_REPLICA_URL=
# S3 on EC2 with an instance role: leave both empty. Otherwise an IAM user's key that can only use that bucket.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# S3 only: the bucket's region.
# AWS_REGION=us-east-1
# Azure Blob on a VM with a managed identity: leave empty. Otherwise a SAS token for the one container.
LITESTREAM_AZURE_SAS_TOKEN=

# --- Optional -----------------------------------------------------------------------------------------------
# Who may set X-Forwarded-For (default: Caddy's network). A CDN in front of Caddy (CloudFront, Front Door): 2
# TRUST_PROXY=2
# A pre-built image (e.g. from ECR or ACR) instead of building on the server.
# OOMBA_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/oomba-academy:2026-10-25
# No cover pictures or Builder playtests at all (the worker then sits idle):
# BRB_SNAPSHOTS=0
# POSTHOG_KEY=
# DEMO_TEACHER_PASSWORD=
