{
  "name": "magic-cup",
  "version": "0.1.0",
  "private": true,
  "description": "Magic Cup: a kid-safe platform where anyone can play, build and publish web games with an AI game builder.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node scripts/seed.js",
    "import-game": "node scripts/import-game.js",
    "backup": "node scripts/backup.js",
    "rollup": "node scripts/rollup.js",
    "test": "node --test tests/unit/*.test.js tests/safety/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:safety": "node --test tests/safety/*.test.js",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.js",
    "covers": "BRB_DB=:memory: BRB_SILENT=1 node scripts/covers.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@fontsource/nunito": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
