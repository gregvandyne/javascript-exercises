  "note": "Appended by the completeness critic (3 Nov 2026). Overrides the generated sections where they conflict; see plan.md 'Critic additions' CA-1..CA-11. gen-contracts.py carries this key over on regeneration.",
  "lockSemantics": {
   "lock=1": "band locked; chapter map and band toggle hidden; start at chapter; at chapter end lesson mode continues into game.then for the band, else results + Back to class",
   "then": {
    "csq-1b-4.1": "routes",
    "csq-1b-4.3": "ciphers (levels 1-3)",
    "csq-1b-5.1": "hw-sw (levels 1-3)"
   },
   "scoreUnderChain": "chained chapters add stars to score (monotonic); label keeps the locked chapter's noun and totals",
   "ciClauseFPrime": "a game step's standards is a subset of the union of csta of its chapter and its then chapters for the band",
   "withdrawn": {
    "csq-2-4.1.mainActivity.first": "routes 1-6 (routes level 5 is the Pro Explore demo; routes 5-6 stretch via then)"
   }
  },
  "scannerRules": {
   "linkCode": "scanner.js:47 LINK_CODE_PROMPT: grown-up(s)|parent(s)|guardian(s)|family|families|mum|mom|dad|link within 40 chars of code(s) in any string literal FAILS; Packet Post never uses the word 'code' (secret message, cipher, key wheel, shift); Robo Route 'quest code'/'level code' strings never mention family/parents/grown-ups",
   "personalPrompt": "scanner.js:44: (enter|type|what's|tell us) (your|ur) (real name|full name|address|phone|email|school|age|birthday|password) FAILS; share/keep tiles are nouns, trick cards never say 'type your password'",
   "contentLint": "tests/unit/cs-quest-content-lint.test.js also runs scanner.scanVersion on each game's sanitized HTML and fails on any fail issue; adds a UK-spelling rule for en strings",
