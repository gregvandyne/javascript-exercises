{
  "_about": "Grammar Lab's own grouping, written by hand (see scripts/grammar-lab-build.js). bands: in order, each with its units (pathways) in order. pathways: a unit's title, its parts (each an ordered list of topic ids, with an optional part title; a topic opens when the one before it in the unit is mastered) and optional marks ({ topic id: 'checkpoint' | 'review' }). topics: each topic once, by id, however many units use it: where its text is in source/course.md (the band section and the topic heading), its quiz format (tap, capfix, gaps or choice, with choices.kind for a choice), the line that asks the question, its levels (questions per level) and, for a topic with a Mistake Hunt room, the room's mistake kinds. scripts/grammar-lab-build.js reads this with source/course.md and writes topics.json.",
  "bands": [
    { "id": "k-2", "grades": "K-2", "readAloud": true, "pathways": ["adjectives-and-adverbs", "capital-letters", "commas", "sound-alike-words", "kinds-of-words", "verbs-and-time"] }
  ],
  "pathways": {
    "adjectives-and-adverbs": { "title": "Adjectives and Adverbs", "parts": [{ "topics": ["identifying-adjectives"] }] },
    "capital-letters": { "title": "Capital Letters", "parts": [
      { "title": "Names and Dates", "topics": ["capitalizing-names-and-dates"] },
      { "title": "Titles", "topics": ["capitalizing-titles"] }
    ] },
    "commas": { "title": "Commas", "parts": [
      { "title": "Lists", "topics": ["commas-in-a-series"] },
      { "title": "Starting Phrases", "topics": ["commas-after-starting-phrases"] }
    ] },
    "sound-alike-words": { "title": "Sound-alike Words", "parts": [{ "topics": ["your-and-youre"] }] },
    "kinds-of-words": { "title": "Kinds of Words", "parts": [
      { "title": "Nouns", "topics": ["identifying-common-nouns"] },
      { "title": "Verbs", "topics": ["identifying-action-verbs"] },
      { "title": "Adjectives", "topics": ["identifying-adjectives"] }
    ] },
    "verbs-and-time": { "title": "Verbs and Time", "parts": [
      { "title": "Action Verbs", "topics": ["identifying-action-verbs"] },
      { "title": "Past, Present, and Future", "topics": ["using-simple-tenses"] }
    ] }
  },
  "topics": {
    "identifying-adjectives": {
      "source": { "band": "k-2", "title": "Identifying Adjectives" },
      "format": "tap",
      "ask": "Tap the adjective.",
      "levels": [4, 4, 4]
    },
    "capitalizing-names-and-dates": {
      "source": { "band": "k-2", "title": "Capitalizing People's Names and Dates" },
      "format": "capfix",
      "ask": "Tap the word that needs a capital letter.",
      "levels": [4, 4, 4],
      "room": { "kinds": ["pc-proper"] }
    },
    "capitalizing-titles": {
      "source": { "band": "k-2", "title": "Rules of Capitalizing Titles" },
      "format": "choice",
      "choices": { "kind": "title" },
      "ask": "Choose the title with the right capital letters.",
      "levels": [4, 4, 4],
      "room": { "kinds": ["pc-proper"], "titlesOnly": true }
    },
    "commas-in-a-series": {
      "source": { "band": "k-2", "title": "Commas with Single Words in a Series" },
      "format": "gaps",
      "ask": "Tap each place a comma goes.",
      "levels": [4, 4, 4],
      "room": { "kinds": ["pc-series"] }
    },
    "commas-after-starting-phrases": {
      "source": { "band": "k-2", "title": "Commas with Prepositional Phrases" },
      "format": "choice",
      "choices": { "kind": "comma" },
      "ask": "Choose the sentence with the comma in the right place.",
      "levels": [4, 4, 4]
    },
    "your-and-youre": {
      "source": { "band": "k-2", "title": "\"Your\" vs. \"You're\"" },
      "format": "choice",
      "choices": { "kind": "pair", "pair": ["your", "you're"] },
      "ask": "Choose the word that fits.",
      "levels": [4, 4, 4],
      "room": { "kinds": ["us-your"] }
    },
    "identifying-common-nouns": {
      "source": { "band": "k-2", "title": "Identifying Common Nouns" },
      "format": "tap",
      "ask": "Tap the noun.",
      "levels": [4, 4, 4]
    },
    "identifying-action-verbs": {
      "source": { "band": "k-2", "title": "Identifying Action Verbs" },
      "format": "tap",
      "ask": "Tap the action verb.",
      "levels": [4, 4, 4]
    },
    "using-simple-tenses": {
      "source": { "band": "k-2", "title": "Using Action Verbs in Simple Tenses" },
      "format": "choice",
      "choices": { "kind": "tense" },
      "ask": "Choose the verb that fits.",
      "levels": [4, 4, 4]
    }
  }
